{
  "name": "@abydahana/iconpicker",
  "version": "1.0.0",
  "description": "Universal, framework-agnostic floating popover icon picker with multi-pack support",
  "author": "Aby Dahana",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./src/themes/index.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node --import tsx build.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
